# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# Base y superusuario del contenedor de desarrollo
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=bodegas_admin
POSTGRES_PASSWORD=cambiar_por_un_secreto_local

# Puerto local (host). Se usa uno alto para no chocar con un PostgreSQL local en 5432.
POSTGRES_PORT=55432
