# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

# Base y superusuario del contenedor de desarrollo
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=bodegas_admin
POSTGRES_PASSWORD=cambiar_por_un_secreto_local

# Puerto local (host). Se usa uno alto para no chocar con un PostgreSQL local en 5432.
POSTGRES_PORT=55432

# API (Etapa 6): se conecta con el rol bodegas_api (lectura/escritura, sin privilegios de propietario).
# API_DB_PASSWORD se completa solo en .env. En el primer arranque (volumen vacío),
# db/init/01_inicializar.sh se la asigna a bodegas_api. Con una base ya existente
# se asigna a mano con \password bodegas_api.
# Con docker compose solo se usan API_DB_USER y API_DB_PASSWORD: el host (db) y el
# puerto (5432) los fija docker-compose.yml. HOST y PORT sirven para correr la API
# fuera de Docker (uvicorn local).
API_DB_HOST=localhost
API_DB_PORT=55432
API_DB_NAME=bodegas_atuel
API_DB_USER=bodegas_api
API_DB_PASSWORD=
